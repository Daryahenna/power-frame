---
import FAQSchema from '../schema/FAQSchema.astro';

interface FaqItem {
  question: string;
  answer: string;
}
interface Props {
  faq: FaqItem[];
}
const { faq } = Astro.props;
---

<FAQSchema faq={faq} />
<section class="section">
  <div class="container-page max-w-3xl">
    <h2 class="section-title">Частые вопросы</h2>
    <div class="mt-6 space-y-3">
      {
        faq.map((item) => (
          <details class="group rounded-xl border border-gray-200 p-5 open:border-brand/40">
            <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-brand-black">
              {item.question}
              <span class="ml-4 text-brand transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-brand-steel">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
