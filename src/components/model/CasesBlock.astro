---
interface CaseItem {
  title: string;
  diagnosis: string;
  work: string;
  duration: string;
  price: string;
  isPlaceholder: boolean;
}
interface Props {
  modelName: string;
  cases: CaseItem[];
}
const { modelName, cases } = Astro.props;
---

<section class="section bg-gray-50">
  <div class="container-page">
    <h2 class="section-title">Кейсы: ремонт рамы {modelName}</h2>
    <p class="todo-badge mt-3">TODO: заменить на реальные кейсы клиента (фото до/после, диагноз, сроки, цена)</p>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        cases.map((c) => (
          <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-100">
            <div class="mb-3 grid grid-cols-2 gap-2">
              <div class="flex aspect-video items-center justify-center rounded-lg bg-gray-200 text-xs text-gray-500">
                [ФОТО ДО]
              </div>
              <div class="flex aspect-video items-center justify-center rounded-lg bg-gray-200 text-xs text-gray-500">
                [ФОТО ПОСЛЕ]
              </div>
            </div>
            <p class="font-semibold text-brand-black">{c.title}</p>
            <dl class="mt-2 space-y-1 text-sm text-brand-steel">
              <div><dt class="inline font-medium">Диагноз: </dt><dd class="inline">{c.diagnosis}</dd></div>
              <div><dt class="inline font-medium">Работы: </dt><dd class="inline">{c.work}</dd></div>
              <div><dt class="inline font-medium">Срок: </dt><dd class="inline">{c.duration}</dd></div>
              <div><dt class="inline font-medium">Стоимость: </dt><dd class="inline">{c.price}</dd></div>
            </dl>
          </div>
        ))
      }
    </div>
  </div>
</section>
