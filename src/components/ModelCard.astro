---
interface Props {
  brandLabel: string;
  modelName: string;
  href: string;
  priceFrom: string;
  blurb: string;
}
const { modelName, href, priceFrom, blurb } = Astro.props;
---

<a href={href} class="group flex flex-col rounded-2xl border border-gray-200 p-5 transition-shadow hover:shadow-lg">
  <div class="mb-4 flex aspect-[4/3] items-center justify-center rounded-xl bg-gray-100 text-xs text-gray-500">
    [ФОТО: {modelName}]
  </div>
  <p class="text-lg font-bold text-brand-black group-hover:text-brand">{modelName}</p>
  <p class="mt-1 flex-1 text-sm text-brand-steel">{blurb}</p>
  <div class="mt-4 flex items-center justify-between">
    <span class="font-semibold text-brand">от {priceFrom}</span>
    <span class="text-sm font-medium text-brand-black group-hover:translate-x-1 group-hover:transition-transform">
      Подробнее →
    </span>
  </div>
</a>
