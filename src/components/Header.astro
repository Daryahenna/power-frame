---
import { SITE } from '../config';

const nav = [
  { name: 'До/после', href: '/#proof' },
  { name: 'Осмотр', href: '/#process' },
  { name: 'Работы', href: '/#services' },
  { name: 'Стоимость', href: '/#price' },
  { name: 'Отзывы', href: '/#reviews' },
];

const hasPhone = !SITE.phone.includes('[');
---

<header id="site-header" class="site-header">
  <div class="container-page header-inner">
    <a href="/" class="brand-lockup" aria-label="Power Frame Beard, главная">
      <span class="brand-mark">BF</span>
      <span class="brand-copy">
        <span class="brand-main">BEARD FRAME</span>
        <span class="brand-sub">сварочная мастерская</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Основная навигация">
      {
        nav.map((item) => (
          <a href={item.href}>{item.name}</a>
        ))
      }
    </nav>

    <div class="header-actions">
      {
        hasPhone ? (
          <a href={SITE.phoneHref} class="header-cta">{SITE.phone}</a>
        ) : (
          <a href="/#contacts" class="header-cta">Осмотр</a>
        )
      }
      <button
        id="menu-toggle"
        class="menu-toggle"
        type="button"
        aria-label="Открыть меню"
        title="Меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Мобильная навигация" hidden>
    <div class="container-page mobile-menu-inner">
      {
        nav.map((item) => (
          <a href={item.href}>{item.name}</a>
        ))
      }
      <a href="/#faq">Вопросы</a>
      {hasPhone && <a href={SITE.phoneHref} class="mobile-phone">Позвонить: {SITE.phone}</a>}
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid rgba(10, 10, 8, 0.12);
    background: rgba(244, 244, 238, 0.92);
    color: #090909;
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    height: 82px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand-lockup {
    display: inline-flex;
    min-width: 224px;
    align-items: center;
    gap: 13px;
    color: #090909;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 7px;
    background: #090909;
    color: #fff;
    font-family: var(--display);
    font-size: 16px;
    line-height: 1;
  }

  .brand-copy {
    display: grid;
    gap: 3px;
  }

  .brand-main {
    color: #090909;
    font-family: var(--display);
    font-size: 20px;
    line-height: 1;
    text-transform: uppercase;
  }

  .brand-sub {
    color: #62625b;
    font-size: 10px;
    font-weight: 900;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .desktop-nav a {
    color: rgba(9, 9, 9, 0.7);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .desktop-nav a:hover {
    color: #e50914;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header-cta {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid #e50914;
    border-radius: 5px;
    padding: 10px 16px;
    background: #e50914;
    color: #fff;
    font-size: 12px;
    font-weight: 900;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .header-cta:hover {
    background: #ff1520;
    transform: translateY(-1px);
  }

  .menu-toggle {
    position: relative;
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(9, 9, 9, 0.22);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.3);
    color: #090909;
  }

  .menu-toggle span,
  .menu-toggle span::before,
  .menu-toggle span::after {
    display: block;
    width: 19px;
    height: 2px;
    background: currentColor;
    content: '';
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .menu-toggle span {
    position: relative;
  }

  .menu-toggle span::before {
    position: absolute;
    top: -7px;
  }

  .menu-toggle span::after {
    position: absolute;
    top: 7px;
  }

  .menu-toggle[aria-expanded='true'] span {
    background: transparent;
  }

  .menu-toggle[aria-expanded='true'] span::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    border-top: 1px solid rgba(9, 9, 9, 0.12);
    background: #f4f4ee;
  }

  .mobile-menu-inner {
    display: grid;
    padding-top: 10px;
    padding-bottom: 18px;
  }

  .mobile-menu a {
    border-bottom: 1px solid rgba(9, 9, 9, 0.12);
    padding: 17px 0;
    color: #090909;
    font-size: 16px;
    font-weight: 900;
    text-decoration: none;
  }

  .mobile-menu a:last-child {
    border-bottom: 0;
  }

  .mobile-menu .mobile-phone {
    color: #e50914;
  }

  @media (max-width: 980px) {
    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }
  }

  @media (max-width: 560px) {
    .brand-lockup {
      min-width: 0;
    }

    .brand-main {
      font-size: 16px;
    }

    .brand-mark {
      width: 44px;
      height: 44px;
    }

    .header-cta {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-cta,
    .menu-toggle span,
    .menu-toggle span::before,
    .menu-toggle span::after {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setMenu = (open: boolean) => {
    if (menu) menu.hidden = !open;
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
    header?.classList.toggle('is-open', open);
  };

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });
</script>
