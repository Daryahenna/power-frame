---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';

const title = 'Ремонт рам автомобилей в Москве';
const description =
  'Диагностика и сварочный ремонт рам автомобилей любых марок: удаление сгнившего металла, ремонт и замена повреждённых участков.';

const services = [
  {
    title: 'Осмотр на подъёмнике',
    text: 'Поднимаем автомобиль, осматриваем раму и простукиваем металл, чтобы понять реальный объём повреждения.',
  },
  {
    title: 'Локальный сварочный ремонт',
    text: 'Вырезаем слабый металл, готовим участок и ввариваем ремонтный элемент там, где это технически оправдано.',
  },
  {
    title: 'Замена повреждённых участков',
    text: 'Когда локальной заплаты недостаточно, меняем часть секции и восстанавливаем силовую зону.',
  },
  {
    title: 'Разборка для доступа',
    text: 'Если к месту ремонта нельзя подойти напрямую, заранее учитываем разборку и обратную сборку машины.',
  },
];

const process = [
  {
    title: 'Звонок',
    text: 'Называете автомобиль и коротко описываете проблему. Мастер говорит, есть ли смысл приезжать на осмотр.',
  },
  {
    title: 'Платный осмотр',
    text: 'Машину поднимают, проверяют доступ и состояние металла не только в видимой дыре, но и рядом.',
  },
  {
    title: 'Цена до начала',
    text: 'Объём, разборка и стоимость согласуются после осмотра. Без цены, взятой с потолка по одной фотографии.',
  },
  {
    title: 'Ремонт и выдача',
    text: 'Слабый металл удаляют, участок ремонтируют, а разобранные элементы возвращают на место.',
  },
];

const priceFactors = [
  'Площадь и количество повреждений',
  'Состояние металла вокруг отверстий',
  'Доступ к месту сварки',
  'Необходимость разборки и обратной сборки',
];

const faq = [
  {
    question: 'Какие автомобили берёте?',
    answer:
      'Рамные автомобили любых марок. Решение по конкретной машине принимается после короткого разговора и осмотра: если работа понятна и выполнима, её берут.',
  },
  {
    question: 'Можно узнать точную цену по фотографии?',
    answer:
      'Нет. Фотография показывает только видимую часть. Для точной цены нужно поднять машину, проверить металл вокруг повреждения и понять, нужна ли разборка.',
  },
  {
    question: 'Есть гарантия на ремонт?',
    answer:
      'Мастерская отвечает за выполненный сварной шов. Но дать гарантию на весь металл сильно корродированной рамы невозможно: рядом с новым швом может разрушиться другой слабый участок.',
  },
  {
    question: 'Снимаете кузов с рамы?',
    answer:
      'На старте мастерская занимается сварочным ремонтом без полного снятия кузова. Частичная разборка возможна, если она нужна для безопасного доступа к месту ремонта.',
  },
  {
    question: 'Есть эвакуатор или хранение машины?',
    answer:
      'Своего эвакуатора, доставки и отдельной стоянки нет. При необходимости владелец организует эвакуатор самостоятельно.',
  },
];
---

<BaseLayout title={title} description={description} image="/og.png" noindex>
  <section class="relative isolate flex min-h-[690px] items-end overflow-hidden bg-ink text-white lg:min-h-[calc(100dvh-72px)]">
    <img
      src="/images/workshop-welding.jpg"
      alt="Работа с повреждённой рамой автомобиля"
      class="absolute inset-0 h-full w-full object-cover object-center"
      width="1800"
      height="1000"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="absolute inset-y-0 left-[calc(50%-1px)] hidden w-px bg-white/15 lg:block"></div>

    <div class="container-page relative z-10 w-full pb-12 pt-20 sm:pb-16 lg:pb-20">
      <div class="max-w-5xl">
        <p class="reveal font-mono text-[11px] font-semibold uppercase text-white/70">
          Москва · Сварочная мастерская
        </p>
        <h1 class="reveal reveal-delay-1 mt-5 max-w-5xl text-5xl font-extrabold leading-[0.96] text-white sm:text-6xl lg:text-7xl">
          Ремонт рам автомобилей
        </h1>
        <p class="reveal reveal-delay-2 mt-7 max-w-2xl text-lg leading-7 text-white/80 sm:text-xl sm:leading-8">
          Поднимаем машину, находим слабый металл, вырезаем сгнившие участки и ввариваем ремонтные элементы. Объём и цена только после осмотра.
        </p>
        <div class="reveal reveal-delay-2 mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="#contacts" class="btn-primary sm:min-w-48">Записаться на осмотр</a>
          <a href="#inspection" class="btn-secondary border-white/70 text-white hover:bg-white hover:text-ink sm:min-w-48">
            Как проходит осмотр
          </a>
        </div>
      </div>

      <div class="mt-12 flex max-w-3xl flex-wrap gap-x-7 gap-y-3 border-t border-white/20 pt-5 font-mono text-[10px] uppercase text-white/60">
        <span>Любые рамные марки</span>
        <span>Осмотр на подъёмнике</span>
        <span>Сварка и замена участков</span>
      </div>
    </div>

    <p class="absolute bottom-4 right-5 z-10 hidden font-mono text-[9px] uppercase text-white/45 sm:block">
      Временная фотография для макета
    </p>
  </section>

  <section class="border-b border-black/10 bg-paper" aria-label="Основные принципы работы">
    <div class="container-page grid md:grid-cols-3">
      <div class="border-b border-black/10 py-6 md:border-b-0 md:border-r md:pr-8">
        <p class="font-mono text-[10px] font-semibold text-signal">01</p>
        <p class="mt-2 font-semibold text-ink">Не маскируем гниль красивым швом</p>
      </div>
      <div class="border-b border-black/10 py-6 md:border-b-0 md:border-r md:px-8">
        <p class="font-mono text-[10px] font-semibold text-signal">02</p>
        <p class="mt-2 font-semibold text-ink">Согласуем объём после доступа к раме</p>
      </div>
      <div class="py-6 md:pl-8">
        <p class="font-mono text-[10px] font-semibold text-signal">03</p>
        <p class="mt-2 font-semibold text-ink">Возвращаем собранный автомобиль</p>
      </div>
    </div>
  </section>

  <section id="services" class="section-shell bg-paper">
    <div class="container-page">
      <div class="max-w-4xl">
        <p class="kicker">Что делаем</p>
        <h2 class="section-heading">Ремонт, который нужен машине сейчас</h2>
        <p class="section-copy">
          Без обещаний полной реставрации. Задача мастерской — восстановить повреждённый участок рамы и вернуть автомобиль владельцу в понятном состоянии.
        </p>
      </div>

      <div class="mt-12 grid border-t border-black/15 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service, index) => (
            <article class="border-b border-black/15 py-7 sm:odd:pr-6 sm:even:border-l sm:even:pl-6 lg:border-l lg:px-6 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0">
              <p class="font-mono text-xs font-semibold text-signal">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-8 text-xl font-bold text-ink">{service.title}</h3>
              <p class="mt-3 text-sm leading-6 text-brand-steel">{service.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-ink text-white">
    <div class="container-page grid gap-10 py-14 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:py-20">
      <div>
        <p class="font-mono text-[11px] font-semibold uppercase text-white/55">Честные границы</p>
        <h2 class="mt-4 text-3xl font-bold leading-[1.05] text-white sm:text-4xl">Чего здесь не обещают</h2>
      </div>
      <div class="grid border-t border-white/20 sm:grid-cols-2">
        <div class="border-b border-white/20 py-5 sm:border-r sm:pr-6">
          <p class="font-semibold">Полное снятие кузова</p>
          <p class="mt-2 text-sm leading-6 text-white/60">На старте мастерская работает без кузовного демонтажа.</p>
        </div>
        <div class="border-b border-white/20 py-5 sm:pl-6">
          <p class="font-semibold">Цинкование рамы</p>
          <p class="mt-2 text-sm leading-6 text-white/60">Для этого нужен другой процесс и дорогое оборудование.</p>
        </div>
        <div class="border-b border-white/20 py-5 sm:border-b-0 sm:border-r sm:pr-6">
          <p class="font-semibold">Точную цену по фото</p>
          <p class="mt-2 text-sm leading-6 text-white/60">Скрытая коррозия и доступ становятся понятны только на подъёмнике.</p>
        </div>
        <div class="py-5 sm:pl-6">
          <p class="font-semibold">Эвакуатор и хранение</p>
          <p class="mt-2 text-sm leading-6 text-white/60">Доставку и стоянку владелец организует самостоятельно.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="inspection" class="section-shell bg-[#fbfaf7]">
    <div class="container-page grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <figure class="overflow-hidden rounded-[6px] bg-ink">
        <div class="aspect-[16/11] overflow-hidden">
          <img
            src="/images/workshop-frame.jpg"
            alt="Осмотр и подготовка повреждённой части автомобиля"
            class="h-full w-full object-cover"
            width="1800"
            height="1000"
            loading="lazy"
          />
        </div>
        <figcaption class="border-t border-white/15 px-5 py-4 font-mono text-[9px] uppercase text-white/55">
          Временная фотография · заменим на реальный материал
        </figcaption>
      </figure>

      <div class="lg:py-4">
        <p class="kicker">Диагностика</p>
        <h2 class="section-heading">Сначала поднять. Потом считать.</h2>
        <p class="section-copy">
          Осмотр платный: он занимает подъёмник и рабочее время. Точную стоимость диагностики называют при записи.
        </p>

        <ol class="mt-9 border-t border-black/15">
          {
            process.map((step, index) => (
              <li class="grid grid-cols-[42px_1fr] gap-3 border-b border-black/15 py-5 sm:grid-cols-[48px_0.7fr_1.3fr] sm:gap-5">
                <span class="font-mono text-xs font-semibold text-signal">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="font-bold text-ink">{step.title}</h3>
                <p class="col-start-2 text-sm leading-6 text-brand-steel sm:col-start-auto">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section id="quality" class="section-shell border-y border-black/10 bg-paper">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="kicker">Почему переделывают чужую работу</p>
          <h2 class="section-heading">Красивый шов ещё не означает прочный ремонт</h2>
          <p class="section-copy">
            Главная ошибка — приварить случайный кусок металла поверх слабого основания. Внешне всё может выглядеть аккуратно, а нагрузку такой ремонт не держит.
          </p>
        </div>

        <div class="grid gap-px overflow-hidden rounded-[6px] border border-black/15 bg-black/15 sm:grid-cols-2">
          <article class="bg-[#e6e4de] p-6 sm:p-8">
            <p class="font-mono text-[10px] font-semibold uppercase text-brand-steel">Как делать не стоит</p>
            <h3 class="mt-12 text-2xl font-bold text-ink">Заплата поверх гнили</h3>
            <p class="mt-4 text-sm leading-6 text-brand-steel">
              Без вырезания слабого металла, подготовки краёв и проверки зоны вокруг.
            </p>
          </article>
          <article class="bg-ink p-6 text-white sm:p-8">
            <p class="font-mono text-[10px] font-semibold uppercase text-white/55">Наш подход</p>
            <h3 class="mt-12 text-2xl font-bold text-white">Открыть и подготовить участок</h3>
            <p class="mt-4 text-sm leading-6 text-white/65">
              Удалить разрушенный металл, подогнать ремонтный элемент и сварить на подготовленном основании.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section id="price" class="section-shell bg-[#fbfaf7]">
    <div class="container-page grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div>
        <p class="kicker">Стоимость</p>
        <h2 class="section-heading">Цена зависит не от марки, а от работы</h2>
        <p class="section-copy">
          Один участок можно сварить при прямом доступе. Ради другого придётся разобрать часть машины, выполнить ремонт и собрать всё обратно.
        </p>
      </div>

      <div>
        <div class="border-y border-black/15 py-7">
          <p class="font-mono text-[10px] font-semibold uppercase text-brand-steel">Ориентир для простого случая</p>
          <p class="mt-3 text-3xl font-extrabold text-ink sm:text-4xl">Локальная сварка — примерно от 10 000 ₽</p>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-brand-steel">
            Только когда повреждение небольшое и к нему есть прямой доступ. Это не фиксированный прайс для любой машины.
          </p>
        </div>

        <div class="mt-7 grid sm:grid-cols-2">
          {
            priceFactors.map((factor, index) => (
              <div class="grid grid-cols-[38px_1fr] gap-3 border-b border-black/15 py-4 sm:odd:pr-5 sm:even:border-l sm:even:pl-5">
                <span class="font-mono text-xs font-semibold text-signal">{String(index + 1).padStart(2, '0')}</span>
                <p class="text-sm font-semibold leading-6 text-ink">{factor}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="works" class="section-shell border-y border-black/10 bg-paper">
    <div class="container-page">
      <div class="max-w-4xl">
        <p class="kicker">Реальные работы</p>
        <h2 class="section-heading">Здесь будут кейсы до, в процессе и после</h2>
        <p class="section-copy">
          Вместо выдуманных историй оставляем готовую структуру. Сюда поставим реальные фотографии и коротко подпишем, что было повреждено и что сделали.
        </p>
      </div>

      <div class="mt-12 grid gap-4 lg:grid-cols-3">
        {
          ['До ремонта', 'Открытый участок', 'После ремонта'].map((label, index) => (
            <div class="work-placeholder flex aspect-[4/3] min-h-[260px] flex-col justify-between rounded-[6px] border border-dashed border-black/25 bg-[#e7e5df] p-5">
              <div class="flex items-center justify-between gap-4">
                <span class="font-mono text-xs font-semibold text-signal">{String(index + 1).padStart(2, '0')}</span>
                <span class="font-mono text-[9px] uppercase text-brand-steel">Место для фото</span>
              </div>
              <div>
                <p class="text-xl font-bold text-ink">{label}</p>
                <p class="mt-2 text-sm leading-6 text-brand-steel">Реальный материал будет добавлен после отбора фотографий.</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="reviews" class="section-shell bg-[#fbfaf7]">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
        <div>
          <p class="kicker">Отзывы владельцев</p>
          <h2 class="section-heading">Без текстов от лица несуществующих клиентов</h2>
          <p class="section-copy">
            Когда появится переписка с клиентами, сюда добавим реальные скриншоты с аккуратно скрытыми личными данными.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {
            [1, 2, 3, 4].map((item) => (
              <div class="review-placeholder min-h-[190px] rounded-[6px] border border-dashed border-black/25 bg-white p-5">
                <div class="flex items-center gap-3">
                  <span class="h-9 w-9 rounded-full bg-black/10"></span>
                  <div class="flex-1">
                    <span class="block h-2.5 w-24 rounded-full bg-black/10"></span>
                    <span class="mt-2 block h-2 w-16 rounded-full bg-black/5"></span>
                  </div>
                </div>
                <div class="mt-7 grid gap-2">
                  <span class="block h-2 w-full rounded-full bg-black/10"></span>
                  <span class="block h-2 w-[86%] rounded-full bg-black/10"></span>
                  <span class="block h-2 w-[62%] rounded-full bg-black/10"></span>
                </div>
                <p class="mt-7 font-mono text-[9px] uppercase text-brand-steel">Скриншот отзыва {item}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="section-shell border-t border-black/10 bg-paper">
    <div class="container-page grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
      <div>
        <p class="kicker">Коротко и по делу</p>
        <h2 class="section-heading">Что важно знать до звонка</h2>
      </div>

      <div class="border-t border-black/15">
        {
          faq.map((item) => (
            <details class="group border-b border-black/15">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-6 text-lg font-bold text-ink sm:text-xl">
                <span>{item.question}</span>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-black/20 text-xl font-normal transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="max-w-2xl pb-7 pr-10 text-sm leading-7 text-brand-steel sm:text-base">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ContactBlock />
</BaseLayout>
