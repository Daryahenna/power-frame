---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { SITE } from '../config';

const title = 'Сварочные работы любой сложности в Москве | Power Frame Beard';
const description =
  'Сварочная мастерская Power Frame Beard в Москве: осмотр на подъёмнике, восстановление рам, усиление слабых участков, локальная сварка и подготовка автомобиля к ремонту.';

const process = [
  {
    title: 'Смотрим металл, а не фото',
    text: 'Фотографии помогают понять масштаб, но решение принимается после подъёмника: важно увидеть слабые места вокруг дефекта.',
  },
  {
    title: 'Открываем повреждение',
    text: 'Срезаем разрушенный металл, проверяем края, убираем старые заплаты и грязь, которая мешает нормальному шву.',
  },
  {
    title: 'Ввариваем ремонтный участок',
    text: 'Подгоняем металл по месту, варим с понятной геометрией, не закрываем гниль красивой накладкой сверху.',
  },
  {
    title: 'Согласуем объём заранее',
    text: 'Цена зависит от доступа, разборки и состояния соседнего металла. До старта работ владелец понимает, за что платит.',
  },
];

const services = [
  {
    title: 'Сварка рамы',
    text: 'Локальное восстановление повреждённых участков, трещин, сгнивших зон и старых неудачных ремонтов.',
  },
  {
    title: 'Усиление металла',
    text: 'Ремонтные элементы, подгонка, проварка и усиление там, где родной металл уже не держит нагрузку.',
  },
  {
    title: 'Разборка для доступа',
    text: 'Снимаем мешающие элементы, если без этого нельзя нормально подготовить металл и выполнить работу.',
  },
  {
    title: 'Осмотр перед покупкой',
    text: 'Показываем реальные слабые места рамы до сделки, чтобы не покупать красивый кузов с плохой основой.',
  },
];

const priceFactors = [
  'Где находится повреждение и насколько к нему можно подойти',
  'Сколько слабого металла придётся удалить',
  'Нужна ли разборка, снятие деталей и обратная сборка',
  'Можно ли сделать локальный ремонт или нужна замена участка',
];

const reviewSlots = [
  {
    title: 'Скрин отзыва',
    text: 'Сюда вставим реальный отзыв клиента после согласования.',
  },
  {
    title: 'Фото до/после',
    text: 'Заменим демонстрационный кадр на материал мастерской.',
  },
  {
    title: 'Комментарий мастера',
    text: 'Коротко объясним, что было с рамой и что сделали.',
  },
];

const faq = [
  {
    question: 'Можно ли понять цену по фото?',
    answer:
      'По фото можно дать предварительное направление. Точную стоимость называют после осмотра на подъёмнике, потому что ржавчина часто уходит дальше видимого края.',
  },
  {
    question: 'Вы делаете только рамные автомобили?',
    answer:
      'Основной фокус - рамные автомобили и сложные сварочные работы по силовым элементам. По другим задачам решение принимается после описания и фотографий.',
  },
  {
    question: 'Почему нельзя просто заварить дырку сверху?',
    answer:
      'Такой ремонт выглядит быстро, но слабый металл остаётся под заплатой. Нормальная работа начинается с удаления разрушенного участка до живого металла.',
  },
  {
    question: 'Сколько длится осмотр?',
    answer:
      'Обычно хватает подъёмника, фотографий зоны повреждения и короткого разговора по объёму. После этого можно обсуждать сроки и стоимость ремонта.',
  },
  {
    question: 'Будет автоматический расчёт по фото?',
    answer:
      'Да, позже добавим предварительный расчёт по фотографиям. Сейчас оставляем понятный путь: фото, разговор, осмотр на подъёмнике.',
  },
];
---

<BaseLayout title={title} description={description} image="/og.jpg" noindex={SITE.isPreview}>
  <section
    class="hero-shell"
    aria-labelledby="hero-title"
    data-rust-reveal
    data-clean-src="/images/power-frame-rust-after.webp"
  >
    <img
      src="/images/power-frame-rust-before.webp"
      srcset="/images/power-frame-rust-before-960.webp 960w, /images/power-frame-rust-before.webp 1920w"
      sizes="100vw"
      alt="Ржавая рама автомобиля перед сварочным ремонтом"
      class="hero-rust-base"
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <canvas class="hero-rust-canvas" data-rust-canvas aria-hidden="true"></canvas>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="container-page hero-content">
      <div class="hero-copy">
        <p class="hero-kicker reveal-intro">Москва / сварочная мастерская</p>
        <h1 id="hero-title" class="hero-title reveal-intro reveal-intro-delay-1">
          <span>Сварочные работы</span>
          <span>любой сложности</span>
        </h1>
        <div class="hero-actions reveal-intro reveal-intro-delay-2">
          <a href="#contacts" class="button button-signal">Записаться на осмотр</a>
          <a href="#process" class="button button-ghost">Как проходит осмотр</a>
        </div>
      </div>

      <figure class="hero-machine reveal-intro reveal-intro-delay-3">
        <img
          src="/images/power-frame-welder.webp"
          srcset="/images/power-frame-welder-720.webp 720w, /images/power-frame-welder.webp 1280w"
          sizes="(min-width: 1024px) 42vw, 72vw"
          alt="Профессиональный сварочный аппарат в мастерской"
          width="1280"
          height="960"
        />
        <figcaption>
          <span>BEARD FRAME</span>
          <strong>Power Frame workshop</strong>
        </figcaption>
      </figure>
    </div>

    <div class="brush-hint" aria-hidden="true">
      <span></span>
      Проведите по ржавчине
    </div>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        <span>Сварочные работы любой сложности</span>
        <span>Осмотр на подъёмнике</span>
        <span>Рама, металл, геометрия</span>
        <span>Без красивых заплат поверх гнили</span>
        <span>Power Frame Beard</span>
        <span>Сварочные работы любой сложности</span>
        <span>Осмотр на подъёмнике</span>
        <span>Рама, металл, геометрия</span>
        <span>Без красивых заплат поверх гнили</span>
        <span>Power Frame Beard</span>
      </div>
    </div>
  </section>

  <section id="proof" class="section section-proof">
    <div class="container-page proof-layout">
      <div class="section-intro" data-reveal>
        <p class="section-kicker">До / после</p>
        <h2 class="display-heading">Один участок. Два состояния металла.</h2>
        <p class="section-lead">
          Пока используем демонстрационный кадр, чтобы показать механику сайта. Реальные фото работ заменят его без перестройки блока.
        </p>
      </div>

      <div class="compare-widget" data-compare data-reveal>
        <img
          src="/images/power-frame-rust-before.webp"
          srcset="/images/power-frame-rust-before-960.webp 960w, /images/power-frame-rust-before.webp 1920w"
          sizes="(min-width: 1024px) 58vw, 100vw"
          alt="Рама до ремонта, коррозия и отверстия в металле"
          width="1920"
          height="1080"
          loading="lazy"
        />
        <div class="compare-after">
          <img
            src="/images/power-frame-rust-after.webp"
            srcset="/images/power-frame-rust-after-960.webp 960w, /images/power-frame-rust-after.webp 1920w"
            sizes="(min-width: 1024px) 58vw, 100vw"
            alt="Та же рама после сварочного ремонта"
            width="1920"
            height="1080"
            loading="lazy"
          />
        </div>
        <div class="compare-label compare-label-before">До</div>
        <div class="compare-label compare-label-after">После</div>
        <div class="compare-divider" aria-hidden="true"></div>
        <input class="compare-range" type="range" min="0" max="100" value="52" aria-label="Сравнить состояние рамы до и после ремонта" />
      </div>
    </div>
  </section>

  <section id="process" class="section section-process">
    <div class="container-page">
      <div class="section-intro section-intro-light" data-reveal>
        <p class="section-kicker">Осмотр и ремонт</p>
        <h2 class="display-heading">Сначала диагностика. Потом сварка.</h2>
        <p class="section-lead">
          Текст из старого первого экрана уходит сюда: владелец сразу видит логику работы и понимает, почему цена появляется после подъёмника.
        </p>
      </div>

      <ol class="process-grid">
        {
          process.map((step, index) => (
            <li class="process-card" data-reveal>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="services" class="section section-services">
    <div class="container-page">
      <div class="section-intro" data-reveal>
        <p class="section-kicker">Работы</p>
        <h2 class="display-heading">Сварочная мастерская, которую легко запомнить</h2>
        <p class="section-lead">
          Power Frame Beard звучит как отдельная мастерская, а не безликий автосервис. Домен остаётся Power-frame.ru, в коммуникации используем короткий запоминаемый бренд.
        </p>
      </div>

      <div class="service-register">
        {
          services.map((service, index) => (
            <article class="service-row" data-reveal>
              <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="price" class="section section-price">
    <div class="container-page price-layout">
      <div class="price-main" data-reveal>
        <p class="section-kicker">Стоимость</p>
        <h2 class="display-heading">Расчёт после осмотра, без угадайки по одной фотографии.</h2>
        <p class="price-value"><span>от</span> 10 000 ₽</p>
        <p class="price-note">
          Ориентир для небольшого локального повреждения с прямым доступом. Финальный прайс и стоимость осмотра заменим после согласования.
        </p>
      </div>

      <div class="price-protocol" data-reveal>
        <div class="protocol-head">
          <span>Что влияет на сумму</span>
          <span>4 фактора</span>
        </div>
        <ol>
          {
            priceFactors.map((factor, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{factor}</strong>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section id="reviews" class="section section-reviews">
    <div class="container-page">
      <div class="section-intro section-intro-light" data-reveal>
        <p class="section-kicker">Отзывы и кейсы</p>
        <h2 class="display-heading">Оставляем места под реальные скрины и фото работ</h2>
      </div>

      <div class="reviews-grid">
        {
          reviewSlots.map((slot, index) => (
            <article class="review-card" data-reveal>
              <div class="review-media">
                {index === 1 ? (
                  <img src="/images/power-frame-rust-after-960.webp" alt="Демонстрационный кадр после сварочного ремонта" loading="lazy" width="960" height="540" />
                ) : (
                  <span>место под материал</span>
                )}
              </div>
              <p class="review-kicker">0{index + 1}</p>
              <h3>{slot.title}</h3>
              <p>{slot.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="faq" class="section section-faq">
    <div class="container-page faq-layout">
      <div class="faq-heading" data-reveal>
        <p class="section-kicker">Вопросы</p>
        <h2 class="display-heading">Что важно знать до осмотра</h2>
      </div>

      <div class="faq-list">
        {
          faq.map((item) => (
            <details data-reveal>
              <summary>
                <span>{item.question}</span>
                <span class="faq-toggle" aria-hidden="true">+</span>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ContactBlock />

  <script>
    document.documentElement.classList.add('has-motion');

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -48px' },
    );

    document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));

    const setupRustReveal = (area) => {
      const canvas = area.querySelector('[data-rust-canvas]');
      const cleanSrc = area.getAttribute('data-clean-src');
      if (!(canvas instanceof HTMLCanvasElement) || !cleanSrc) return;

      const context = canvas.getContext('2d');
      const mask = document.createElement('canvas');
      const maskContext = mask.getContext('2d');
      const cleanImage = new Image();
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let lastPoint = null;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);

      if (!context || !maskContext) return;

      cleanImage.src = cleanSrc;

      const coverRect = () => {
        const imageRatio = cleanImage.naturalWidth / cleanImage.naturalHeight;
        const canvasRatio = canvas.width / canvas.height;
        let width = canvas.width;
        let height = canvas.height;

        if (imageRatio > canvasRatio) {
          height = canvas.height;
          width = height * imageRatio;
        } else {
          width = canvas.width;
          height = width / imageRatio;
        }

        return {
          x: (canvas.width - width) / 2,
          y: (canvas.height - height) / 2,
          width,
          height,
        };
      };

      const render = () => {
        if (!cleanImage.complete || !cleanImage.naturalWidth) return;
        const rect = coverRect();
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.drawImage(cleanImage, rect.x, rect.y, rect.width, rect.height);
        context.globalCompositeOperation = 'destination-in';
        context.drawImage(mask, 0, 0);
        context.globalCompositeOperation = 'source-over';
      };

      const resize = () => {
        const bounds = area.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.max(1, Math.round(bounds.width * dpr));
        canvas.height = Math.max(1, Math.round(bounds.height * dpr));
        mask.width = canvas.width;
        mask.height = canvas.height;
        render();
      };

      const drawPoint = (x, y, radius) => {
        maskContext.save();
        maskContext.fillStyle = '#fff';
        maskContext.shadowColor = '#fff';
        maskContext.shadowBlur = radius * 0.22;
        maskContext.beginPath();
        maskContext.arc(x, y, radius, 0, Math.PI * 2);
        maskContext.fill();
        maskContext.restore();
      };

      const paint = (event) => {
        const bounds = canvas.getBoundingClientRect();
        const x = (event.clientX - bounds.left) * dpr;
        const y = (event.clientY - bounds.top) * dpr;
        const radius = (window.innerWidth < 768 ? 50 : 78) * dpr;

        if (lastPoint) {
          const dx = x - lastPoint.x;
          const dy = y - lastPoint.y;
          const distance = Math.hypot(dx, dy);
          const steps = Math.max(1, Math.ceil(distance / (radius * 0.38)));
          for (let index = 0; index <= steps; index += 1) {
            drawPoint(lastPoint.x + (dx * index) / steps, lastPoint.y + (dy * index) / steps, radius);
          }
        } else {
          drawPoint(x, y, radius);
        }

        lastPoint = { x, y };
        render();
      };

      const autoStroke = () => {
        if (reduceMotion) return;
        const y = canvas.height * 0.54;
        const start = canvas.width * 0.28;
        const end = canvas.width * 0.62;
        const radius = (window.innerWidth < 768 ? 42 : 62) * dpr;
        let frame = 0;
        const total = 58;

        const tick = () => {
          const progress = frame / total;
          const x = start + (end - start) * progress;
          drawPoint(x, y + Math.sin(progress * Math.PI * 2) * 26 * dpr, radius);
          render();
          frame += 1;
          if (frame <= total) requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      };

      cleanImage.addEventListener('load', () => {
        resize();
        window.setTimeout(autoStroke, 900);
      });

      area.addEventListener('pointermove', paint);
      area.addEventListener('pointerleave', () => {
        lastPoint = null;
      });
      area.addEventListener('pointerdown', (event) => {
        area.setPointerCapture?.(event.pointerId);
        paint(event);
      });

      window.addEventListener('resize', resize);
      resize();
    };

    document.querySelectorAll('[data-rust-reveal]').forEach(setupRustReveal);

    document.querySelectorAll('[data-compare]').forEach((widget) => {
      const range = widget.querySelector('.compare-range');
      if (!(range instanceof HTMLInputElement)) return;

      const update = () => {
        widget.style.setProperty('--compare', `${range.value}%`);
      };

      range.addEventListener('input', update);
      update();
    });
  </script>
</BaseLayout>
