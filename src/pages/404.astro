---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена — 404" description="Запрашиваемая страница не найдена." noindex={true}>
  <section class="section">
    <div class="container-page flex flex-col items-center py-24 text-center">
      <p class="text-6xl font-extrabold text-brand">404</p>
      <h1 class="mt-4 text-2xl font-bold text-brand-black">Страница не найдена</h1>
      <p class="mt-3 text-brand-steel">Возможно, страница была перемещена или удалена.</p>
      <a href="/" class="btn-primary mt-6">На главную</a>
    </div>
  </section>
</BaseLayout>
